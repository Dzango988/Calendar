<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_oval"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок: сегодняшняя дата -->
        <TextView
            android:id="@+id/widget_today_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сегодня"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:letterSpacing="0.1" />

        <!-- Иконка/эмодзи события -->
        <TextView
            android:id="@+id/widget_event_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="📅"
            android:textSize="28sp" />

        <!-- Название события или "нет дат" -->
        <TextView
            android:id="@+id/widget_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="Сегодня нет важных дат"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Обратный отсчёт -->
        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text=""
            android:textColor="#DDFFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>
